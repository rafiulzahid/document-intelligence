# Copy this file to .env (same folder) and fill in ONE of the options. .env is never committed to git.

# --- Option A: local model on your GPU with Ollama (free, private) -----------------
DOCINTEL_LLM_PROVIDER=openai
DOCINTEL_LLM_BASE_URL=http://localhost:11434/v1
DOCINTEL_LLM_MODEL=qwen2.5-8k
DOCINTEL_LLM_API_KEY=

# --- Option B: OpenAI ---------------------------------------------------------------
# DOCINTEL_LLM_PROVIDER=openai
# DOCINTEL_LLM_MODEL=gpt-4o-mini
# DOCINTEL_LLM_API_KEY=sk-...

# --- Option C: Anthropic Claude -------------------------------------------------------
# DOCINTEL_LLM_PROVIDER=anthropic
# DOCINTEL_LLM_MODEL=<a Claude model id from docs.claude.com>
# DOCINTEL_LLM_API_KEY=sk-ant-...

# --- Option D: Google Gemini (OpenAI-compatible endpoint) ----------------------------
# DOCINTEL_LLM_PROVIDER=openai
# DOCINTEL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DOCINTEL_LLM_MODEL=<a Gemini model id>
# DOCINTEL_LLM_API_KEY=...

# OCR backend: auto (EasyOCR on GPU if installed, else Tesseract) | tesseract | easyocr
DOCINTEL_OCR=auto

# ================= Backend (step 6) =================
# Database: PostgreSQL (docker compose up -d postgres redis) ...
DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel
# ... or no setup at all: DATABASE_URL=sqlite:///data/app.db
# Background jobs: rq (Redis + "rq worker docintel") | thread (inside the API, no Redis)
QUEUE_MODE=rq
REDIS_URL=redis://localhost:6379/0
# Clients must send this in the X-API-Key header (empty = no auth, local only)
API_KEY=change-me
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
# Semantic search embeddings: openai (Ollama /v1/embeddings) | sentence_transformers | hash | none
EMBED_PROVIDER=openai
EMBED_MODEL=nomic-embed-text
# EMBED_BASE_URL defaults to DOCINTEL_LLM_BASE_URL
